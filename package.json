{
  "name": "dreamscape",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "productName": "Dreamscape",
  "description": "Dreamscape — мечты, вписанные в реальную жизнь",
  "author": "Dreamscape",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "phone": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:art": "tsx scripts/verify-art.mjs",
    "desktop": "concurrently -k -n vite,electron -c magenta,cyan \"vite\" \"wait-on http://localhost:5173 && node electron/launch.cjs\"",
    "desktop:prod": "vite build && electron .",
    "desktop:build": "vite build && electron-builder --mac",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "framer-motion": "^14.9.1",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "app.dreamscape.journey",
    "productName": "Dreamscape",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.lifestyle",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    }
  }
}
