# ──────────────────────────────────────────────────────────────
# DREAMSCAPE environment template — copy to .env.local
# Every variable is optional. With nothing set, the app runs in
# fully-local demo/guest mode (data stays in the browser).
# ──────────────────────────────────────────────────────────────

# Supabase (Auth + Postgres + RLS). Enables accounts & cloud sync.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PostHog (privacy-first product analytics; no reflection text is ever sent)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Public site URL used for auth email redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
